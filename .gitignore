# Build output: the skill zip is made by tools/make_zip.py and attached to a
# GitHub release, never committed.
dist/
*.zip

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets and private lists: never in this public repository.
.env
.env.*
*.pem
*.key
*.p12
*.mobileprovision
*denylist*.txt

# Workbooks a maintainer tried things on (tests/fixtures and tests/scenarios
# are the only workbooks kept, and are listed explicitly).
*.sprd
*.xlsx
*.xls
*.csv
!tests/fixtures/*.sprd
!tests/scenarios/*.csv
~$*

# Editors and operating systems
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code's local files
.claude/settings.local.json
